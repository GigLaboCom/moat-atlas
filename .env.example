# Astro inlines every PUBLIC_ variable at build time, so a dist/ or an image is
# tied to the values it was built with. Copy this file to .env for a local build.

# Absolute base for canonical, hreflang and OG URLs.
PUBLIC_SITE_URL=http://localhost:4321

# GA4 measurement id. Empty means no analytics at all — no gtag, no page view.
# The production id lives in the GitHub Actions variable PUBLIC_GA_ID and is
# baked in by the release workflow; leave this empty unless you deliberately
# want hits from your machine in that property.
PUBLIC_GA_ID=

# Region check for the consent banner. Defaults to /api-shared/ip on the same
# origin — set this only for a deployment that serves it somewhere else.
PUBLIC_GEO_ENDPOINT=

# Dev-only stand-in for that check: eu | non-eu. A production build ignores it.
PUBLIC_GEO_SIMULATE=
