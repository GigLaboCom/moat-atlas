---
/**
 * The worked example on the home page: one calculator result, drawn from
 * `src/data/sample-result.ts` through the real scoring, wearing the same
 * gauge and bars as the result screen of sheet II (`src/styles/result.css`).
 * The whole card is a link to the live result — the hash codec makes the
 * address at build time, so the card and the calculator cannot disagree —
 * and the mechanics it holds are links to their sheets on top of it.
 */
import type { Locale } from "../i18n/config";
import { getTranslations, getLocalizedPath } from "../i18n/index";
import { calculatorPage } from "../i18n/translations/pages/calculator";
import { getMoatStrings } from "../i18n/translations/moats/index";
import { ROCK_COLORS, byNumber, type DepthLevel } from "../data/moats";
import { SEGMENT_ROCK } from "../data/survey";
import { SAMPLE_CODE, SAMPLE_RESULT } from "../data/sample-result";
import { fillHome, homeStrings } from "../lib/home";
import "../styles/result.css";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const c = calculatorPage[lang];
const h = homeStrings(lang);
const r = SAMPLE_RESULT;
const level = r.depth as DepthLevel;
const href = `${getLocalizedPath("/calculator/", lang)}#s=${SAMPLE_CODE}`;
const depthValue = c.result.depthValue
  .replace("{level}", String(level))
  .replace("{tool}", t.atlas.ruler[level].tool);
---

<section class="sample" aria-labelledby="sample-caption">
  <p class="caption" id="sample-caption">{fillHome(lang, h.sample.above)}</p>

  <div class="card result" data-code={SAMPLE_CODE} data-index={r.index} data-depth={r.depth}>
    <p class="name">{h.sample.product}</p>

    <div class="verdict">
      <div class="gauge">
        <strong>{r.index}</strong>
        <span>{depthValue}</span>
      </div>
      <div>
        <p>{c.verdicts[level]}</p>
        <p class="rival">{c.result.rivalNeeds.replace("{years}", t.atlas.ruler[level].years)}</p>
      </div>
    </div>

    <h3>{c.result.segmentsTitle}</h3>
    <ul class="segbars">
      {r.segments.map((seg) => (
        <li>
          <b>
            {c.segments[seg.key].name}
            {(seg.key === r.strongest || seg.key === r.weakest) && (
              <span class="tag">{seg.key === r.strongest ? c.result.strongest : c.result.weakest}</span>
            )}
          </b>
          <div class="track">
            <i style={`width:${seg.score}%;background:${ROCK_COLORS[SEGMENT_ROCK[seg.key]]}`}></i>
          </div>
          <span class="pct">{seg.score}</span>
        </li>
      ))}
    </ul>

    <h3>{h.sample.mechanics}</h3>
    <ul class="chips">
      {r.holding.map((n) => (
        <li>
          <a href={getLocalizedPath(`/moats/${n}/`, lang)}>
            <i style={`background:${ROCK_COLORS[byNumber[n].rock]}`}></i>
            <span class="n">#{n}</span>
            {getMoatStrings(lang, n).name}
          </a>
        </li>
      ))}
    </ul>

    <!-- Stretched over the card by its ::after; the chips sit above it. -->
    <a class="open" href={href}>{h.sample.open}</a>
  </div>

  <p class="below">{h.sample.below}</p>
</section>

<style>
  /* Where it sits is the page's call — beside the hero or under it. */
  .sample { max-width: 640px; }

  .caption {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 12px;
  }

  .card {
    position: relative;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 20px 22px 18px;
    transition: border-color 0.15s ease;
  }

  .card:hover { border-color: var(--ink-dim); }

  .name {
    font-family: var(--display);
    font-size: 20px;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin-bottom: 14px;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    margin-bottom: 18px;
  }

  /* Above the stretched link, so a chip opens its sheet and not the calculator. */
  .chips a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--line);
    padding: 5px 10px;
    font-size: 12.5px;
    color: var(--ink);
  }

  .chips a:hover { border-color: var(--ink-dim); text-decoration: underline; text-underline-offset: 3px; }
  .chips i { width: 8px; height: 8px; flex: 0 0 auto; }
  .chips .n { font-family: var(--mono); font-size: 10.5px; color: var(--ink-faint); }

  .open {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink);
    border-bottom: 1px solid var(--ink-dim);
    padding-bottom: 2px;
  }

  .open::after { content: ""; position: absolute; inset: 0; }
  .card:hover .open { border-color: var(--ink); }

  .below { margin-top: 12px; font-size: 12.5px; line-height: 1.6; color: var(--ink-faint); }

  @media (max-width: 640px) {
    .card { padding: 16px 16px 14px; }
  }
</style>
