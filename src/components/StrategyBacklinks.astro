---
/**
 * "Strategies that lead here" — sheet III's back-links on a moat sheet.
 *
 * Fed by the derived map in `src/data/strategies.ts`, never hand-listed: the
 * three lists are the strategies whose `moats[]` name this moat, by kind. A
 * moat nothing leads to *directly* says so out loud, above whatever reaches
 * it via another moat or under a condition — that gap is a finding the owner
 * wants on the page, not an empty block.
 *
 * Rendered inside `#sheet-article`, so the atlas modal shows it too; its
 * rules in `index.astro` go through `:global()` like the rest of the sheet.
 */
import type { Locale } from "../i18n/config";
import { getTranslations, getLocalizedPath } from "../i18n/index";
import { backlinksFor, type Strategy } from "../data/strategies";
import { nameOf, noteOf } from "../lib/strategies";

export interface Props {
  lang: Locale;
  n: number;
}

const { lang, n } = Astro.props;
const t = getTranslations(lang);
const b = backlinksFor(n);
const href = (s: Strategy) => getLocalizedPath(`/strategies/${s.slug}/`, lang);
---

<section class="backlinks" id="strategies">
  <h2>{t.sheet.strategies.title}</h2>
  {b.direct.length === 0 && <p class="none">{t.sheet.strategies.none}</p>}

  {b.direct.length > 0 && (
    <ul class="direct">
      {b.direct.map((s) => (
        <li><a href={href(s)} data-strategy={s.slug}>{nameOf(s, lang)}</a></li>
      ))}
    </ul>
  )}

  {b.via.length > 0 && (
    <div class="kind">
      <h3>{t.sheet.strategies.via}</h3>
      <ul>
        {b.via.map((s) => (
          <li><a href={href(s)} data-strategy={s.slug}>{nameOf(s, lang)}</a></li>
        ))}
      </ul>
    </div>
  )}

  {b.conditional.length > 0 && (
    <div class="kind">
      <h3>{t.sheet.strategies.conditional}</h3>
      <ul>
        {b.conditional.map((s) => (
          <li>
            <a href={href(s)} data-strategy={s.slug}>{nameOf(s, lang)}</a>
            {noteOf(s, lang) && <span class="note"> — {noteOf(s, lang)}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .backlinks ul {
    list-style: none;
    display: grid;
    gap: 1px;
    border-top: 1px solid var(--line);
  }

  .backlinks li {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    line-height: 1.55;
  }

  .backlinks .kind { margin-top: 16px; }

  .backlinks h3 {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 6px;
  }

  .backlinks .note { color: var(--ink-dim); }
  .backlinks .none { color: var(--ink-dim); }
</style>
