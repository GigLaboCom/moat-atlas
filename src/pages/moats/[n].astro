---
import PageLayout from "../../layouts/PageLayout.astro";
import type { Locale } from "../../i18n/config";
import { getTranslations, getLocalizedPath } from "../../i18n/index";
import { getMoatStrings, isDraft } from "../../i18n/translations/moats/index";
import { MOATS, byNumber, ROCK_COLORS, MOAT_COUNT } from "../../data/moats";
import { sheetMeta } from "../../lib/seo/pages";

export function getStaticPaths() {
  return MOATS.map((m) => ({ params: { n: String(m.n) } }));
}

const headerLocale = Astro.request.headers.get("x-locale") as Locale | null;
const lang: Locale = headerLocale ?? "en";
const t = getTranslations(lang);

const n = Number(Astro.params.n);
const moat = byNumber[n];
const s = getMoatStrings(lang, n);
const draft = isDraft(s);

const depthLevel = Math.round(moat.d) as 1 | 2 | 3 | 4;
const capLevel = Math.round(moat.capN) as 1 | 2 | 3 | 4;

const passport = [
  { label: t.catalogue.columns.rock, value: t.rocks[moat.rock] },
  { label: t.catalogue.columns.depth, value: `${moat.d} · ${t.atlas.ruler[depthLevel].tool}` },
  { label: t.sheet.years, value: t.atlas.ruler[depthLevel].years },
  // The dictionary value leads with its own glyph ("● high"); the matrix glyph
  // is kept because it can be a range ("◐–●"), so only the word is taken here.
  { label: t.catalogue.columns.cap, value: `${moat.cap} · ${t.values.cap[capLevel].replace(/^\S+\s+/, "")}` },
  { label: t.catalogue.columns.solo, value: t.values.solo[moat.solo] },
  { label: t.catalogue.columns.ai, value: t.values.ai[moat.ai] },
  { label: t.catalogue.columns.rent, value: t.values.rent[moat.rent] },
];

/** Only the first thirteen mechanics were measured; the rest have no figures. */
const sample = moat.sample
  ? [
      { label: t.sheet.sample.share, value: `${moat.sample.share}%` },
      { label: t.sheet.sample.noRate, value: `${moat.sample.noRate}%` },
      { label: t.sheet.sample.median, value: `$${moat.sample.median}` },
    ]
  : null;
const sampleNote = moat.sample?.n
  ? t.sheet.sample.small.replace("{n}", String(moat.sample.n))
  : null;

const prev = n > 1 ? n - 1 : null;
const next = n < MOAT_COUNT ? n + 1 : null;

const homePath = getLocalizedPath("/", lang);

// Shared with the sheet's `.md` twin and its llms.txt entry so the three can
// never drift; the structured data is emitted by the layout from the same index.
const { title, description } = sheetMeta(lang, n);
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  basePath={`/moats/${n}/`}
  section={`${t.sheet.eyebrow} ${n}`}
>
  <!-- The same trail the page's BreadcrumbList asserts, made walkable. The
       Atlas crumb lands on this sheet's own core; the script below keeps the
       reader's view, so arriving from the list means returning to it. -->
  <nav class="crumbs" aria-label={t.ui.breadcrumbs}>
    <a href={`${homePath}#moat-${n}`} id="crumb-atlas">{t.ui.footer.atlas}</a>
    <span class="sep" aria-hidden="true">/</span>
    <a href={getLocalizedPath("/moats/", lang)}>{t.ui.footer.catalogue}</a>
    <span class="sep" aria-hidden="true">/</span>
    <span aria-current="page">{t.sheet.eyebrow} {n}</span>
  </nav>

  <!-- The atlas fetches this page and lifts #sheet-article into its modal, so
       everything the modal should show lives inside it and the page chrome
       (crumbs, prev/next) stays outside. -->
  <article id="sheet-article">
  <div class="eyebrow">
    {t.sheet.eyebrow} {n} / {MOAT_COUNT}
    <span class="rock-tag">
      <i style={`background:${ROCK_COLORS[moat.rock]}`}></i>{t.rocks[moat.rock]}
    </span>
  </div>
  <h1>{s.name}</h1>

  {draft && <p class="draft">{t.sheet.draft}</p>}

  <section class="passport">
    <h2>{t.sheet.passport}</h2>
    <dl>
      {passport.map((row) => (
        <div class="row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {sample && (
    <section class="sample">
      <h2>{t.sheet.sample.title}</h2>
      <dl>
        {sample.map((row) => (
          <div class="row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
      {sampleNote && <p class="note">{sampleNote}</p>}
      <p class="note">{t.sheet.sample.note}</p>
    </section>
  )}

  <section>
    <h2>{t.sheet.essence}</h2>
    {s.essence ? <p>{s.essence}</p> : <p class="placeholder">—</p>}
  </section>

  <section>
    <h2>{t.sheet.build}</h2>
    {s.build.length ? (
      s.build.map((ex) => (
        <div class="example">
          <h3>{ex.lead}</h3>
          <p>{ex.text}</p>
        </div>
      ))
    ) : (
      <p class="placeholder">—</p>
    )}
  </section>

  <section>
    <h2>{t.sheet.bypass}</h2>
    {s.bypass.length ? (
      s.bypass.map((ex) => (
        <div class="example">
          <h3>{ex.lead}</h3>
          <p>{ex.text}</p>
        </div>
      ))
    ) : (
      <p class="placeholder">—</p>
    )}
  </section>

  <section class="verdict">
    <h2>{t.sheet.verdict}</h2>
    {s.verdict ? <p>{s.verdict}</p> : <p class="placeholder">—</p>}
  </section>

  </article>

  <nav class="sheet-nav">
    {prev ? (
      <a href={getLocalizedPath(`/moats/${prev}/`, lang)} data-sheet-step>{t.sheet.prev}</a>
    ) : (
      <span></span>
    )}
    <span class="mid">
      <!-- Unhidden by the script below only when the setup says the reader
           came from the list — a cold visit keeps just the section link. -->
      <a id="sheet-back" href={`${homePath}?view=list#moat-${n}`} hidden>
        {t.sheet.backToList}
      </a>
      <a href={`${homePath}#moat-${n}`}>{t.sheet.showInAtlas}</a>
    </span>
    {next ? (
      <a href={getLocalizedPath(`/moats/${next}/`, lang)} data-sheet-step>{t.sheet.next}</a>
    ) : (
      <span></span>
    )}
  </nav>

  <script>
    // Sheet I keeps its whole setup in the URL, and the links that lead here
    // carry it into this page's own address — so the Atlas crumb sends the
    // reader back to exactly what they left, and prev/next pass the setup
    // down the chain. The referrer is only the fallback for bare old links;
    // no storage anywhere. A sheet reached cold keeps the plain scene crumb.
    const KEYS = ["view", "group", "rock", "depth"];
    const own = new URLSearchParams(window.location.search);
    let source: URLSearchParams | null = KEYS.some((k) => own.has(k)) ? own : null;
    if (!source && document.referrer) {
      try {
        const ref = new URL(document.referrer);
        if (ref.origin === window.location.origin && KEYS.some((k) => ref.searchParams.has(k))) {
          source = ref.searchParams;
        }
      } catch {
        // An unparseable referrer changes nothing.
      }
    }
    if (source) {
      const carry = source;
      const apply = (a: HTMLAnchorElement) => {
        const url = new URL(a.href);
        for (const key of KEYS) {
          const value = carry.get(key);
          if (value) url.searchParams.set(key, value);
        }
        a.href = url.toString();
      };
      const crumb = document.getElementById("crumb-atlas") as HTMLAnchorElement | null;
      if (crumb) apply(crumb);
      for (const a of document.querySelectorAll<HTMLAnchorElement>("a[data-sheet-step]")) {
        apply(a);
      }
      // A reader who came from the list gets the words for it, not just the
      // trail: the same restoring address, spelled out at the bottom.
      const back = document.getElementById("sheet-back") as HTMLAnchorElement | null;
      if (back && carry.get("view") === "list") {
        apply(back);
        back.hidden = false;
      }
    }
  </script>
</PageLayout>

<style>
  /* The crumb links keep the page's own link dress — only the trail's frame
     is styled here. */
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 26px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .crumbs .sep,
  .crumbs [aria-current] { color: var(--ink-faint); }

  .eyebrow { display: flex; align-items: center; gap: 14px; }

  .rock-tag { display: inline-flex; align-items: center; gap: 6px; letter-spacing: 0.16em; }
  .rock-tag i { width: 8px; height: 8px; }

  .draft {
    border: 1px solid var(--line);
    border-left: 2px solid var(--ink-dim);
    padding: 12px 14px;
    font-size: 13px;
    margin: 20px 0 36px;
  }

  .passport dl, .sample dl { border-top: 1px solid var(--line); }

  .example { margin-bottom: 18px; }
  .example:last-child { margin-bottom: 0; }
  .example h3 { font-size: 14px; font-weight: 600; margin-bottom: 4px; color: var(--ink); }

  .verdict {
    border-left: 2px solid var(--ink-faint);
    padding-left: 16px;
  }

  .sample .note {
    margin-top: 10px;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .row {
    display: flex;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }

  dt {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    min-width: 140px;
  }

  dd { color: var(--ink); margin-left: auto; text-align: right; }

  .placeholder { color: var(--ink-faint); font-family: var(--mono); }

  .sheet-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  /* The middle slot stacks its ways out: back to the list (when it applies)
     over the section link. */
  .mid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    text-align: center;
  }

  @media (max-width: 640px) {
    .row { flex-direction: column; gap: 4px; }
    dd { margin-left: 0; text-align: left; }
    .sheet-nav { flex-direction: column; align-items: flex-start; }
    .mid { align-items: flex-start; text-align: left; }
  }
</style>
