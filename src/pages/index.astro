---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import type { Locale } from "../i18n/config";
import { getTranslations, getLocalizedPath } from "../i18n/index";
import { getAllMoatStrings } from "../i18n/translations/moats/index";
import {
  MOATS,
  ROCK_ORDER,
  DEPTH_LEVELS,
  GROUPING_AXES,
  ROCK_COLORS,
  moatsInBucket,
} from "../data/moats";

const headerLocale = Astro.request.headers.get("x-locale") as Locale | null;
const lang: Locale = headerLocale ?? "en";
const t = getTranslations(lang);
const names = getAllMoatStrings(lang);

const rockCounts = ROCK_ORDER.map((rock) => ({
  rock,
  count: MOATS.filter((m) => m.rock === rock).length,
}));

/** How many of the 35 sit at each depth — the tally bars on the ruler. */
const depthCounts = Object.fromEntries(
  DEPTH_LEVELS.map((l) => [l, moatsInBucket("depth", String(l)).length]),
) as Record<(typeof DEPTH_LEVELS)[number], number>;
const maxDepthCount = Math.max(...Object.values(depthCounts));

/**
 * Everything the scene needs that the matrix cannot carry: the localized names,
 * row labels for each grouping axis and the strings of the HUD it writes into.
 * The matrix itself is imported by the script straight from `src/data/moats.ts`.
 */
const sceneData = {
  sheetBase: getLocalizedPath("/moats/", lang),
  names: Object.fromEntries(
    MOATS.map((m) => [m.n, { name: names[m.n].name, essence: names[m.n].essence }]),
  ),
  rockNames: t.rocks,
  bucketLabels: {
    rock: Object.fromEntries(ROCK_ORDER.map((r) => [r, t.rocks[r]])),
    depth: t.values.depth,
    cap: t.values.cap,
    solo: t.values.solo,
    ai: t.values.ai,
    rent: t.values.rent,
  },
  axisLabels: t.atlas.axes,
  tools: Object.fromEntries(DEPTH_LEVELS.map((l) => [String(l), t.atlas.ruler[l].tool])),
  depthLabels: t.values.depth,
  status: {
    atlas: t.atlas.status.atlas,
    grouping: t.atlas.status.grouping,
    isolated: t.atlas.status.isolated,
    isolatedDepth: t.atlas.status.isolatedDepth,
  },
  specimen: { eyebrow: t.atlas.specimen.eyebrow, rock: t.atlas.specimen.rock },
  draft: t.sheet.draft,
  loading: t.atlas.loading,
};
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
  fixed={true}
>
  <canvas id="scene" aria-hidden="true"></canvas>

  <noscript>
    <div class="noscript">
      <p>{t.atlas.fallback}</p>
      <a href={getLocalizedPath("/moats/", lang)}>{t.atlas.fallbackLink}</a>
    </div>
  </noscript>

  <!-- Same copy for the WebGL-less case; the scene unhides it if it cannot start. -->
  <div class="noscript" id="webgl-fallback" hidden>
    <p>{t.atlas.fallback}</p>
    <a href={getLocalizedPath("/moats/", lang)}>{t.atlas.fallbackLink}</a>
  </div>

  <!-- header plate + mode tabs -->
  <header class="hud top">
    <div class="plate">
      <div class="eyebrow">{t.atlas.eyebrow}</div>
      <h1>{t.atlas.title}</h1>
      <div class="rule"></div>
      <p class="sub">{t.atlas.subtitle}</p>
    </div>

    <div class="top-right">
      <SiteHeader lang={lang} basePath="/" />
      <nav class="tabs" aria-label={t.atlas.tabs.atlas.title}>
        <span class="tab active">
          <strong>{t.atlas.tabs.atlas.title}</strong>
          <span>{t.atlas.tabs.atlas.sub}</span>
        </span>
        <a class="tab" href={getLocalizedPath("/calculator/", lang)}>
          <strong>{t.atlas.tabs.calc.title}</strong>
          <span>{t.atlas.tabs.calc.sub}</span>
        </a>
      </nav>

      <button class="guide-open" id="guide-open" type="button" aria-haspopup="dialog">
        <span aria-hidden="true">?</span>{t.atlas.guide.open}
      </button>
    </div>
  </header>

  <!-- depth ruler: the key to the vertical axis, and the second isolation filter -->
  <aside class="hud ruler" aria-label={t.atlas.ruler.heading}>
    <h3>{t.atlas.ruler.heading}</h3>
    <p class="caption">{t.atlas.ruler.caption}</p>
    <ul id="depth-list">
      {DEPTH_LEVELS.map((lvl) => (
        <li data-depth={lvl}>
          <span class="lvl">{lvl}</span>
          <span class="tool">
            {t.atlas.ruler[lvl].tool}
            <em class="yrs">{t.atlas.ruler[lvl].years}</em>
          </span>
          <span class="tally">
            <i style={`--w:${depthCounts[lvl] / maxDepthCount}`}></i>
            <b>{depthCounts[lvl]}</b>
          </span>
        </li>
      ))}
    </ul>
  </aside>

  <!-- specimen card -->
  <aside class="hud card specimen" id="specimen">
    <button class="close" id="card-close" hidden aria-label={t.atlas.specimen.close}>✕</button>
    <div class="eyebrow" id="card-eyebrow">{t.atlas.specimen.empty_eyebrow}</div>
    <h2 id="card-title">{t.atlas.specimen.empty_title}</h2>
    <div class="stats" id="card-stats" hidden>
      <div>{t.atlas.specimen.stats.depth} <b id="s-depth"></b></div>
      <div>{t.atlas.specimen.stats.cap} <b id="s-cap"></b></div>
      <div>{t.atlas.specimen.stats.solo} <b id="s-solo"></b></div>
      <div>{t.atlas.specimen.stats.ai} <b id="s-ai"></b></div>
      <div>{t.atlas.specimen.stats.rent} <b id="s-rent"></b></div>
    </div>
    <p id="card-body">{t.atlas.specimen.empty_body}</p>
    <a href="#" id="card-link" hidden>{t.atlas.specimen.link}</a>
  </aside>

  <!-- grouping + rock isolation -->
  <aside class="hud legend">
    <h3>{t.atlas.legend.grouping}</h3>
    <div class="groupers" id="groupers">
      {GROUPING_AXES.map((axis, i) => (
        <button class:list={["grp", { on: i === 0 }]} data-axis={axis} type="button">
          {t.atlas.axes[axis]}
        </button>
      ))}
    </div>

    <h3>{t.atlas.legend.rocks}</h3>
    <ul id="legend-list">
      {rockCounts.map(({ rock, count }) => (
        <li data-rock={rock}>
          <i style={`background:${ROCK_COLORS[rock]}`}></i>
          {t.rocks[rock]}
          <em>{count}</em>
        </li>
      ))}
    </ul>

    <div class="foot" set:html={t.atlas.legend.foot}></div>
  </aside>

  <!-- the full sheet, over the section — the page at /moats/N/ stays as it is -->
  <dialog class="sheet-modal" id="sheet-modal" aria-label={t.atlas.specimen.link}>
    <button class="close" id="modal-close" aria-label={t.atlas.specimen.close}>✕</button>
    <div id="modal-body"></div>
    <a class="modal-page" id="modal-page" href="#">{t.atlas.specimen.page}</a>
  </dialog>

  <!-- the guide: what the drawing means, and what the section can be asked to do -->
  <dialog class="guide-modal" id="guide-modal" aria-labelledby="guide-title">
    <button class="close" id="guide-close" aria-label={t.atlas.guide.close}>✕</button>
    <h2 id="guide-title">{t.atlas.guide.title}</h2>
    <p class="lede">{t.atlas.guide.lede}</p>
    <dl>
      {t.atlas.guide.sections.map((section) => (
        <div class="row">
          <dt>{section.title}</dt>
          <dd>{section.body}</dd>
        </div>
      ))}
    </dl>
  </dialog>

  <!-- status line + interaction hint -->
  <div class="hud status"><span id="tooltip">{t.atlas.loading}</span></div>
  <div class="hud hint"><span>{t.atlas.hint}</span></div>

  <!-- The section is the one page with no page chrome, so the site footer joins
       the HUD: the catalogue, the colophon and the cookie policy have to be one
       click from here too. Same component as every other page. -->
  <div class="hud footer-hud">
    <SiteFooter lang={lang} />
  </div>

  <script define:vars={{ sceneData }} is:inline>
    // Handed to the scene module below; kept inline so the 3D layer stays
    // language-aware without a second fetch.
    window.__ATLAS__ = sceneData;
  </script>

  <script>
    import "../scripts/atlas";
    // Separate from the scene: the guide has to open even where WebGL does not.
    import "../scripts/guide";
  </script>
</Layout>

<style>
  #scene {
    position: fixed;
    inset: 0;
    /* The element owns its size and the renderer follows it — a canvas is a
       replaced element, so with `inset: 0` and no width it would take its
       intrinsic (device-pixel) width and overflow the viewport on retina. */
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    /* Orbit, pinch and wheel are the scene's own gestures; without this the
       browser claims the touch for panning and the section never turns. */
    touch-action: none;
    /* Painted by the renderer; the earth colour keeps the first frame from
       flashing white. */
    background: var(--earth);
  }

  #scene.dragging { cursor: grabbing; }

  .noscript {
    position: fixed;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    max-width: 420px;
    text-align: center;
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 20px 24px;
    font-size: 13px;
    color: var(--ink-dim);
  }

  .noscript a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  .hud { position: fixed; z-index: 10; pointer-events: none; }
  .hud > * { pointer-events: auto; }

  /* header */
  .top {
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 22px 26px;
    gap: 16px;
  }

  .top-right { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
  .top-right :global(.site-header) { border-bottom: 0; padding-bottom: 0; }
  .top-right :global(.logo) { display: none; }

  .plate .eyebrow {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 8px;
  }

  .plate h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(26px, 4vw, 44px);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .plate .rule { width: 64px; height: 1px; background: var(--ink-dim); margin: 10px 0 8px; }
  .plate .sub { font-size: 12px; color: var(--ink-dim); max-width: 340px; line-height: 1.5; }

  /* mode tabs */
  .tabs {
    display: flex;
    border: 1px solid var(--line);
    background: var(--panel);
    backdrop-filter: blur(6px);
  }

  .tab {
    padding: 12px 18px 10px;
    text-align: left;
    color: var(--ink-dim);
    border-left: 1px solid var(--line);
    cursor: pointer;
  }

  .tab:first-child { border-left: 0; }

  .tab strong {
    display: block;
    font-family: var(--display);
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .tab span {
    display: block;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: 4px;
    color: var(--ink-faint);
  }

  .tab.active { color: var(--ink); background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .tab.active span { color: var(--ink-dim); }

  /* "How it works" — the key to everything the section does. It sits under the
     tabs in the corner stack and reads as a control, not as a link. */
  .guide-open {
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--line);
    background: var(--panel);
    backdrop-filter: blur(6px);
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 8px 13px;
    cursor: pointer;
  }

  .guide-open:hover { color: var(--ink); border-color: var(--ink-dim); }

  .guide-open span {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 9px;
    line-height: 1;
  }

  /* The guide's own body — a definition list, the same shape as a passport. */
  .guide-modal h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(22px, 3vw, 30px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .guide-modal .lede {
    margin: 12px 0 22px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-dim);
    max-width: 62ch;
  }

  .guide-modal dl { border-top: 1px solid var(--line); }

  .guide-modal .row {
    display: flex;
    gap: 22px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .guide-modal dt {
    flex: 0 0 128px;
    padding-top: 2px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .guide-modal dd { font-size: 13.5px; line-height: 1.7; color: var(--ink-dim); }

  @media (max-width: 640px) {
    .guide-modal .row { flex-direction: column; gap: 6px; }
    .guide-modal dt { flex: none; }
  }

  /* Depth ruler — the key to the vertical axis. It reads like the legend
     because it works like it: a row is a filter, and its bar is how many of
     the 35 lie that deep. */
  .ruler {
    left: 26px;
    /* Under the title plate, not centred: centred it drifted into the legend
       below it on anything shorter than a desktop screen. */
    top: 176px;
    background: var(--panel);
    border: 1px solid var(--line);
    backdrop-filter: blur(6px);
    padding: 14px 16px;
    width: 244px;
  }

  .ruler h3 {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* A whole sentence, so it drops the mono uppercase of the other captions. */
  .ruler .caption {
    margin: 7px 0 11px;
    font-size: 10.5px;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .ruler ul { list-style: none; display: grid; gap: 2px; }

  .ruler li {
    display: grid;
    grid-template-columns: 16px 1fr 48px;
    align-items: center;
    gap: 10px;
    padding: 6px;
    border: 1px solid transparent;
    color: var(--ink-dim);
    cursor: pointer;
  }

  .ruler li:hover, .ruler li.on { color: var(--ink); }
  .ruler li.on { border-color: var(--line); background: color-mix(in srgb, var(--ink) 5%, transparent); }

  .ruler .lvl {
    font-family: var(--mono);
    font-size: 16px;
    line-height: 1;
    color: inherit;
  }

  .ruler .tool {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ruler .yrs {
    display: block;
    font-size: 10px;
    font-style: normal;
    text-transform: none;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
    margin-top: 3px;
  }

  /* The tally: a bar scaled against the fullest depth, then the count. */
  .ruler .tally { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
  .ruler .tally i { height: 3px; width: calc(var(--w) * 26px); background: var(--ink-faint); }
  .ruler li:hover .tally i, .ruler li.on .tally i { background: var(--ink-dim); }

  .ruler .tally b {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    color: var(--ink-faint);
    min-width: 14px;
    text-align: right;
  }

  /* legend */
  .legend {
    left: 26px;
    bottom: 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    backdrop-filter: blur(6px);
    padding: 14px 16px;
    max-width: 280px;
  }

  .legend h3 {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 9px;
  }

  .groupers + h3 { margin-top: 12px; }
  .groupers { display: flex; flex-wrap: wrap; gap: 4px; }

  .grp {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    padding: 5px 8px;
    cursor: pointer;
  }

  .grp:hover { color: var(--ink); border-color: var(--ink-dim); }
  .grp.on { color: var(--ink); background: color-mix(in srgb, var(--ink) 8%, transparent); border-color: var(--ink-dim); }

  .legend ul { list-style: none; display: grid; gap: 4px; }

  .legend li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    color: var(--ink-dim);
    cursor: pointer;
    padding: 3px 6px;
    border: 1px solid transparent;
  }

  .legend li:hover { color: var(--ink); }
  .legend li.on { color: var(--ink); border-color: var(--line); background: color-mix(in srgb, var(--ink) 5%, transparent); }
  .legend i { width: 10px; height: 10px; flex: 0 0 auto; }
  .legend em { font-style: normal; color: var(--ink-faint); font-family: var(--mono); font-size: 10px; margin-left: auto; }

  .legend .foot {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    line-height: 1.6;
  }


  /* ── the sheet modal ─────────────────────────────────── */
  /* Its body is lifted out of /moats/N/, so it arrives without the scope
     attribute Astro stamps on this page — every rule below has to be global. */
  .sheet-modal,
  .guide-modal {
    width: min(720px, calc(100vw - 32px));
    max-height: min(84vh, 900px);
    margin: auto;
    padding: 32px 36px 28px;
    border: 1px solid var(--line);
    background: var(--panel-solid);
    color: var(--ink);
    overflow: auto;
    position: relative;
  }

  .sheet-modal::backdrop,
  .guide-modal::backdrop { background: rgba(10, 8, 5, 0.66); }

  .sheet-modal .close,
  .guide-modal .close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-dim);
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
  }

  .sheet-modal .close:hover,
  .guide-modal .close:hover { color: var(--ink); border-color: var(--ink-dim); }

  .sheet-modal .modal-page {
    display: inline-block;
    margin-top: 26px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
  }

  .sheet-modal .modal-page:hover { color: var(--ink); }

  .sheet-modal :global(.eyebrow) {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 10px;
  }

  .sheet-modal :global(.rock-tag) { display: inline-flex; align-items: center; gap: 6px; }
  .sheet-modal :global(.rock-tag i) { width: 8px; height: 8px; }

  .sheet-modal :global(h1) {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }

  .sheet-modal :global(h2) {
    font-family: var(--display);
    font-weight: 400;
    font-size: 18px;
    letter-spacing: 0.03em;
    margin-bottom: 10px;
  }

  .sheet-modal :global(h3) {
    font-family: var(--body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .sheet-modal :global(p) { font-size: 14px; line-height: 1.7; color: var(--ink-dim); }
  .sheet-modal :global(section) { margin-bottom: 28px; }
  .sheet-modal :global(section:last-of-type) { margin-bottom: 0; }

  .sheet-modal :global(.example) { margin-bottom: 18px; }
  .sheet-modal :global(.example:last-child) { margin-bottom: 0; }

  .sheet-modal :global(.verdict) { border-left: 2px solid var(--ink-faint); padding-left: 16px; }

  .sheet-modal :global(.sample .note) {
    margin-top: 10px;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .sheet-modal :global(.draft) {
    border: 1px solid var(--line);
    border-left: 2px solid var(--ink-dim);
    padding: 12px 14px;
    font-size: 13px;
    margin: 18px 0 30px;
  }

  /* Both the passport and the sample block are the same two-column list. */
  .sheet-modal :global(dl) { border-top: 1px solid var(--line); }

  .sheet-modal :global(.row) {
    display: flex;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }

  .sheet-modal :global(dt) {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    min-width: 140px;
  }

  .sheet-modal :global(dd) { color: var(--ink); margin-left: auto; text-align: right; }
  .sheet-modal :global(.placeholder) { color: var(--ink-faint); font-family: var(--mono); }

  @media (max-width: 640px) {
    .sheet-modal { padding: 26px 18px 22px; }
    .sheet-modal :global(.row) { flex-direction: column; gap: 4px; }
    .sheet-modal :global(dd) { margin-left: 0; text-align: left; }
  }

  /* specimen card */
  .specimen {
    right: 26px;
    top: 50%;
    transform: translateY(-46%);
    width: 296px;
    background: var(--panel);
    border: 1px solid var(--line);
    backdrop-filter: blur(6px);
    padding: 18px;
  }

  .specimen .close {
