---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SampleResult from "../components/SampleResult.astro";
import type { Locale } from "../i18n/config";
import { getTranslations, getLocalizedPath } from "../i18n/index";
import { getAllMoatStrings } from "../i18n/translations/moats/index";
import {
  MOATS,
  ROCK_ORDER,
  DEPTH_LEVELS,
  GROUPING_AXES,
  ROCK_COLORS,
  moatsInBucket,
  type DepthLevel,
  type Moat,
} from "../data/moats";
import { SAMPLE_PULSE } from "../data/sample-result";
import { GUIDE_FINEPRINT_KEY, GUIDE_READING_KEYS } from "../lib/guide";
import { fillHome, homeDescription, homeSteps, homeStrings, strategiesTeaser } from "../lib/home";

const headerLocale = Astro.request.headers.get("x-locale") as Locale | null;
const lang: Locale = headerLocale ?? "en";
const t = getTranslations(lang);
const names = getAllMoatStrings(lang);
const h = homeStrings(lang);
const guide = t.atlas.guide;
const finePrint = guide.sections[GUIDE_FINEPRINT_KEY];

const calculatorPath = getLocalizedPath("/calculator/", lang);
const strategiesPath = getLocalizedPath("/strategies/", lang);
const aboutPath = getLocalizedPath("/about/", lang);

/** Every count in the copy comes from the data — see `src/lib/home.ts`. */
const description = homeDescription(lang);
const steps = homeSteps(lang);
const cta = h.hero.cta;

const rockGroups = ROCK_ORDER.map((rock) => ({
  rock,
  items: MOATS.filter((m) => m.rock === rock),
}));
const rockCounts = rockGroups.map(({ rock, items }) => ({ rock, count: items.length }));

/** The passport of one moat as the list view's chip row, all dictionary text. */
const chipRow = (m: Moat) => [
  t.values.depth[Math.round(m.d) as DepthLevel],
  t.values.cap[Math.round(m.capN) as 1 | 2 | 3 | 4],
  t.values.solo[m.solo],
  t.values.ai[m.ai],
  t.values.rent[m.rent],
];

/** How many of the 35 sit at each depth — the tally bars on the ruler. */
const depthCounts = Object.fromEntries(
  DEPTH_LEVELS.map((l) => [l, moatsInBucket("depth", String(l)).length]),
) as Record<(typeof DEPTH_LEVELS)[number], number>;
const maxDepthCount = Math.max(...Object.values(depthCounts));

/**
 * Everything the scene needs that the matrix cannot carry: the localized names,
 * row labels for each grouping axis and the strings of the HUD it writes into.
 * The matrix itself is imported by the script straight from `src/data/moats.ts`.
 */
const sceneData = {
  sheetBase: getLocalizedPath("/moats/", lang),
  names: Object.fromEntries(
    MOATS.map((m) => [m.n, { name: names[m.n].name, essence: names[m.n].essence }]),
  ),
  rockNames: t.rocks,
  bucketLabels: {
    rock: Object.fromEntries(ROCK_ORDER.map((r) => [r, t.rocks[r]])),
    depth: t.values.depth,
    cap: t.values.cap,
    solo: t.values.solo,
    ai: t.values.ai,
    rent: t.values.rent,
  },
  axisLabels: t.atlas.axes,
  tools: Object.fromEntries(DEPTH_LEVELS.map((l) => [String(l), t.atlas.ruler[l].tool])),
  depthLabels: t.values.depth,
  status: {
    atlas: t.atlas.status.atlas,
    grouping: t.atlas.status.grouping,
    isolated: t.atlas.status.isolated,
    isolatedDepth: t.atlas.status.isolatedDepth,
    first: t.atlas.status.first,
    highlighted: t.atlas.status.highlighted,
  },
  specimen: { eyebrow: t.atlas.specimen.eyebrow, rock: t.atlas.specimen.rock },
  draft: t.sheet.draft,
  loading: t.atlas.loading,
  // The shaft the bare section points at — the sample card's deepest mechanic.
  firstContact: { pulse: SAMPLE_PULSE },
};
---

<Layout title={t.meta.title} description={description} lang={lang}>
  <!-- Before anything paints: `?view=list` opens the section in its text mode.
       Everything else keys off this class; where WebGL cannot start, the
       scene module sets it too, so the list is also the fallback. -->
  <script is:inline>
    if (new URLSearchParams(location.search).get("view") === "list") {
      document.documentElement.classList.add("view-list");
    }
  </script>

  <a href="#content" class="skip-link">{t.ui.skipToContent}</a>

  <div class="column">
    <SiteHeader lang={lang} basePath="/" />
  </div>

  <main id="content">
    <div class="column">
      <!-- The fold: what the page is for, what to press, and what comes out —
           the worked example beside the promise on a desktop, right under it
           on a phone. The brand is the eyebrow; the canvas is a screen away. -->
      <div class="fold">
        <section class="hero" aria-labelledby="hero-title">
          <p class="eyebrow">{t.atlas.title}</p>
          <h1 id="hero-title">{h.hero.title}</h1>
          <p class="sub">{description}</p>
          <a class="btn" href={calculatorPath}>{cta}</a>
          <p class="trust">{h.hero.trust}</p>
          <p class="explore"><a href="#section">{fillHome(lang, h.hero.explore)}</a></p>
        </section>

        <SampleResult lang={lang} />
      </div>

      <section class="steps" aria-labelledby="steps-title">
        <h2 id="steps-title">{h.steps.title}</h2>
        <ol>
          {steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <a class="btn" href={calculatorPath}>{cta}</a>
      </section>
    </div>

    <!-- Sheet I proper: the cross-section, its instruments, and the guide to
         reading it — folded, because the drawing is entered from the result
         above, not cold. -->
    <section class="section" id="section" aria-labelledby="section-title">
      <div class="column">
        <h2 id="section-title">{fillHome(lang, h.section.title)}</h2>
        <p class="caption">{h.section.caption}</p>

        <details class="guide" id="guide">
          <summary>{h.section.guide}</summary>
          <p class="lede">{guide.lede}</p>
          <dl>
            {GUIDE_READING_KEYS.map((key) => (
              <div class="row">
                <dt>{guide.sections[key].title}</dt>
                <dd>{guide.sections[key].body}</dd>
              </div>
            ))}
          </dl>
          <p class="full"><a href={aboutPath}>{h.section.fullGuide}</a></p>
        </details>
      </div>

      <div class="stage" id="stage">
        <canvas id="scene" aria-hidden="true"></canvas>

        <noscript>
          <div class="noscript">
            <p>{t.atlas.fallback}</p>
            <a href={getLocalizedPath("/moats/", lang)}>{t.atlas.fallbackLink}</a>
          </div>
        </noscript>

        <!-- the top strip: the view switch, the sheet tabs, the help button -->
        <header class="hud top">
          <!-- The same 35 sheets, drawn or written. Links, because a view is an
               address — ?view=list — and the script only saves the round trip. -->
          <nav class="view-switch" aria-label={t.atlas.view.label}>
            <a data-view="scene" href={getLocalizedPath("/", lang)} aria-current="true">
              {t.atlas.view.scene}
            </a>
            <a data-view="list" href={`${getLocalizedPath("/", lang)}?view=list`}>
              {t.atlas.view.list}
            </a>
          </nav>

          <div class="top-right">
            <!-- Calculator first: the page's hierarchy, not the sheet numbers. -->
            <nav class="tabs" aria-label={t.atlas.tabs.atlas.title}>
              <a class="tab" href={calculatorPath}>
                <strong>{t.atlas.tabs.calc.title}</strong>
                <span>{t.atlas.tabs.calc.sub}</span>
              </a>
              <span class="tab active">
                <strong>{t.atlas.tabs.atlas.title}</strong>
                <span>{t.atlas.tabs.atlas.sub}</span>
              </span>
              <a class="tab" href={strategiesPath}>
                <strong>{t.atlas.tabs.strategies.title}</strong>
                <span>{t.atlas.tabs.strategies.sub}</span>
              </a>
            </nav>

            <button class="guide-open" id="guide-open" type="button" aria-controls="guide">
              <span aria-hidden="true">?</span>{guide.open}
            </button>
          </div>
        </header>

        <!-- The controls rail: grouping, rock isolation and the depth ruler serve
             the drawing and the list alike, so they share one wrapper — panels
             over the scene, a sidebar (or column) beside the list. -->
        <div class="side">
          <!-- grouping + rock isolation -->
          <aside class="hud legend">
            <h3>{t.atlas.legend.grouping}</h3>
            <div class="groupers" id="groupers">
              {GROUPING_AXES.map((axis, i) => (
                <button class:list={["grp", { on: i === 0 }]} data-axis={axis} type="button">
                  {t.atlas.axes[axis]}
                </button>
              ))}
            </div>

            <h3>{t.atlas.legend.rocks}</h3>
            <ul id="legend-list">
              {rockCounts.map(({ rock, count }) => (
                <li data-rock={rock}>
                  <i style={`background:${ROCK_COLORS[rock]}`}></i>
                  {t.rocks[rock]}
                  <em>{count}</em>
                </li>
              ))}
            </ul>

            <div class="foot" set:html={t.atlas.legend.foot}></div>
          </aside>

          <!-- depth ruler: the key to the vertical axis, and the second isolation filter -->
          <aside class="hud ruler" aria-label={t.atlas.ruler.heading}>
            <h3>{t.atlas.ruler.heading}</h3>
            <p class="caption">{t.atlas.ruler.caption}</p>
            <ul id="depth-list">
              {DEPTH_LEVELS.map((lvl) => (
                <li data-depth={lvl}>
                  <span class="lvl">{lvl}</span>
                  <span class="tool">
                    {t.atlas.ruler[lvl].tool}
                    <em class="yrs">{t.atlas.ruler[lvl].years}</em>
                  </span>
                  <span class="tally">
                    <i style={`--w:${depthCounts[lvl] / maxDepthCount}`}></i>
                    <b>{depthCounts[lvl]}</b>
                  </span>
                </li>
              ))}
            </ul>
          </aside>
        </div>

        <!-- specimen card -->
        <aside class="hud card specimen" id="specimen">
          <button class="close" id="card-close" hidden aria-label={t.atlas.specimen.close}>✕</button>
          <div class="eyebrow" id="card-eyebrow">{t.atlas.specimen.empty_eyebrow}</div>
          <h3 id="card-title">{t.atlas.specimen.empty_title}</h3>
          <div class="stats" id="card-stats" hidden>
            <div>{t.atlas.specimen.stats.depth} <b id="s-depth"></b></div>
            <div>{t.atlas.specimen.stats.cap} <b id="s-cap"></b></div>
            <div>{t.atlas.specimen.stats.solo} <b id="s-solo"></b></div>
            <div>{t.atlas.specimen.stats.ai} <b id="s-ai"></b></div>
            <div>{t.atlas.specimen.stats.rent} <b id="s-rent"></b></div>
          </div>
          <p id="card-body">{t.atlas.specimen.empty_body}</p>
          <a href="#" id="card-link" hidden>{t.atlas.specimen.link}</a>
        </aside>

        <!-- Sheet I's text mode: the same matrix as readable entries, server-rendered
             grouped by rock (the default axis). atlas-list.ts re-groups and filters;
             the entry anchors make /?view=list#moat-7 a walkable address. -->
        <section class="atlas-list" aria-label={t.atlas.view.list}>
          <div id="list-groups">
            {rockGroups.map(({ rock, items }) => (
              <section class="list-group">
                <h3>
                  <i class="dot" style={`background:${ROCK_COLORS[rock]}`}></i>
                  <span>{t.rocks[rock]}</span>
                  <em>{items.length}</em>
                </h3>
                <ol>
                  {items.map((m) => (
                    <li class="entry" id={`moat-${m.n}`} data-n={m.n}>
                      <div class="entry-head">
                        <span class="n">{m.n}</span>
                        <h4>
                          <a href={getLocalizedPath(`/moats/${m.n}/`, lang)}>{names[m.n].name}</a>
                        </h4>
                      </div>
                      <ul class="chips" aria-label={t.sheet.passport}>
                        <li>
                          <i class="dot" style={`background:${ROCK_COLORS[m.rock]}`}></i>
                          {t.rocks[m.rock]}
                        </li>
                        {chipRow(m).map((chip) => <li>{chip}</li>)}
                      </ul>
                      <p class:list={["essence", { draft: !names[m.n].essence }]}>
                        {names[m.n].essence || t.sheet.draft}
                      </p>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        </section>

        <!-- status line + interaction hint. The status is live only while it
             carries the first-contact hint; the scene drops the attribute. -->
        <div class="hud status" aria-live="polite"><span id="tooltip">{t.atlas.loading}</span></div>
        <div class="hud hint"><span>{t.atlas.hint}</span></div>
      </div>
    </section>

    <div class="column">
      <!-- Sheet III, in one line -->
      <section class="teaser" aria-labelledby="teaser-title">
        <h2 id="teaser-title">{fillHome(lang, h.teaser.title)}</h2>
        <p>{strategiesTeaser(lang)}</p>
        <p class="more"><a href={strategiesPath}>{h.teaser.link}</a></p>
      </section>

      <section class="fineprint" aria-labelledby="fineprint-title">
        <h2 id="fineprint-title">{finePrint.title}</h2>
        <p>{finePrint.body}</p>
      </section>
    </div>
  </main>

  <div class="column">
    <SiteFooter lang={lang} />
  </div>

  <!-- the full sheet, over the section — the page at /moats/N/ stays as it is -->
  <dialog class="sheet-modal" id="sheet-modal" aria-label={t.atlas.specimen.link}>
    <button class="close" id="modal-close" aria-label={t.atlas.specimen.close}>✕</button>
    <div id="modal-body"></div>
    <a class="modal-page" id="modal-page" href="#">{t.atlas.specimen.page}</a>
  </dialog>

  <script define:vars={{ sceneData }} is:inline>
    // Handed to the scene module; kept inline so the 3D layer stays
    // language-aware without a second fetch.
    window.__ATLAS__ = sceneData;
  </script>

  <script>
    // The list and the controls bind at once; the scene waits for the canvas
    // to come near the viewport (atlas-lazy.ts), so the fold never pays for it.
    import "../scripts/atlas-list";
    import "../scripts/atlas-lazy";
    // Separate from the scene: the guide has to open even where WebGL does not.
    import "../scripts/guide";
  </script>
</Layout>

<style>
  /* ── the page ────────────────────────────────────────── */
  /* The same column every content page reads in; the stage alone runs the
     full width of the window, between two of them. */
  .column { max-width: 1280px; margin: 0 auto; padding: 0 32px; }
  .column:first-child { padding-top: 40px; }
  .column:last-child { padding-bottom: 40px; }

  /* The home page shows the brand in the hero, not next to the controls. */
  .column :global(.site-header .logo) { display: none; }

  h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: 0.03em;
    line-height: 1.25;
  }

  /* ── the fold ────────────────────────────────────────── */
  .fold {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 460px);
    gap: 40px 64px;
    align-items: start;
  }

  .fold :global(.sample) { margin-top: 64px; }

  @media (max-width: 900px) {
    .fold { grid-template-columns: 1fr; gap: 0; }
    .fold :global(.sample) { margin-top: 40px; }
  }

  .hero { padding: 56px 0 8px; max-width: 720px; }

  .hero .eyebrow {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 14px;
  }

  .hero h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(34px, 5.2vw, 60px);
    letter-spacing: 0.01em;
    line-height: 1.08;
    max-width: 16ch;
  }

  .hero .sub {
    margin-top: 18px;
    max-width: 60ch;
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.6;
    color: var(--ink-dim);
  }

  .hero .btn { margin-top: 26px; padding: 14px 26px; font-size: 12px; }

  .hero .trust {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  .hero .explore { margin-top: 22px; font-size: 14px; }
  .hero .explore a,
  .teaser .more a,
  .guide .full a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--ink-faint);
  }
  .hero .explore a:hover,
  .teaser .more a:hover,
  .guide .full a:hover { text-decoration-color: var(--ink); }

  /* ── the three steps ─────────────────────────────────── */
  .steps { margin-top: 56px; }
  .steps h2 { margin-bottom: 22px; }

  .steps ol {
    list-style: none;
    counter-reset: step;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 32px;
  }

  .steps li { counter-increment: step; border-top: 1px solid var(--line); padding-top: 14px; }

  .steps li::before {
    content: counter(step, decimal-leading-zero);
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
    margin-bottom: 10px;
  }

  .steps h3 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 20px;
    letter-spacing: 0.02em;
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .steps p { font-size: 14px; line-height: 1.7; color: var(--ink-dim); max-width: 38ch; }
  .steps .btn { margin-top: 28px; }

  /* ── the section heading and its guide ───────────────── */
  .section { margin-top: 72px; }
  .section .column > h2 { margin-bottom: 8px; }
  .section .caption { font-size: 14px; line-height: 1.6; color: var(--ink-dim); max-width: 64ch; }

  .guide { margin-top: 18px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

  .guide summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .guide summary::-webkit-details-marker { display: none; }
  .guide summary::before { content: "+"; width: 1em; color: var(--ink-faint); }
  .guide[open] summary::before { content: "−"; }
  .guide summary:hover { color: var(--ink); }

  .guide .lede {
    margin: 4px 0 18px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-dim);
    max-width: 62ch;
  }

  .guide dl { border-top: 1px solid var(--line); }

  .guide .row {
    display: flex;
    gap: 22px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .guide dt {
    flex: 0 0 128px;
    padding-top: 2px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .guide dd { font-size: 13.5px; line-height: 1.7; color: var(--ink-dim); max-width: 72ch; }
  .guide .full { padding: 14px 0 16px; font-size: 13px; }

  /* ── the teaser and the fine print ───────────────────── */
  .teaser { margin-top: 64px; max-width: 720px; }
  .teaser p { margin-top: 10px; font-size: 14px; line-height: 1.7; color: var(--ink-dim); }
  .teaser .more { margin-top: 10px; }

  .fineprint { margin-top: 48px; max-width: 720px; }
  .fineprint h2 {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 8px;
  }
  .fineprint p { font-size: 12.5px; line-height: 1.7; color: var(--ink-faint); }

  /* ── the stage ───────────────────────────────────────── */
  /* The drawing owns a screen of its own, and the instruments hang on it the
     way they used to hang on the window: absolute where they were fixed. */
  .stage {
    position: relative;
    height: 100svh;
    min-height: 620px;
    margin-top: 22px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    /* Where the deep links land: the strip is the target, not the heading. */
    scroll-margin-top: 0;
  }

  #scene {
    position: absolute;
    inset: 0;
    /* The element owns its size and the renderer follows it — a canvas is a
       replaced element, so with `inset: 0` and no width it would take its
       intrinsic (device-pixel) width and overflow the box on retina. */
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    /* Orbit, pinch and wheel are the scene's own gestures on a fine pointer;
       without this the browser claims the touch for panning and the section
       never turns. The coarse-pointer branch below trades vertical pans back
       to the page, which has a hero above the drawing to come back from. */
    touch-action: none;
    /* Painted by the renderer; the earth colour keeps the first frame from
       flashing white. */
    background: var(--earth);
  }

  #scene.dragging { cursor: grabbing; }

  .noscript {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    max-width: 420px;
    text-align: center;
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 20px 24px;
    font-size: 13px;
    color: var(--ink-dim);
  }

  .noscript a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  .hud { position: absolute; z-index: 10; pointer-events: none; }
  .hud > * { pointer-events: auto; }

  /* the top strip */
  .top {
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 22px 26px;
    gap: 16px;
  }

  .top-right { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }

  /* mode tabs */
  .tabs {
    display: flex;
    border: 1px solid var(--line);
    background: var(--panel);
    backdrop-filter: blur(6px);
  }

  .tab {
    padding: 12px 18px 10px;
    text-align: left;
    color: var(--ink-dim);
    border-left: 1px solid var(--line);
    cursor: pointer;
  }

  .tab:first-child { border-left: 0; }

  .tab strong {
    display: block;
    font-family: var(--display);
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .tab span {
    display: block;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: 4px;
    color: var(--ink-faint);
  }

  .tab.active { color: var(--ink); background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .tab.active span { color: var(--ink-dim); }

  /* "How it works" — opens the guide above the stage. It sits under the tabs
     in the corner stack and reads as a control, not as a link. */
  .guide-open {
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--line);
    background: var(--panel);
    backdrop-filter: blur(6px);
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 8px 13px;
    cursor: pointer;
  }

  .guide-open:hover { color: var(--ink); border-color: var(--ink-dim); }

  .guide-open span {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 9px;
    line-height: 1;
  }

  /* Depth ruler — the key to the vertical axis. It reads like the legend
     because it works like it: a row is a filter, and its bar is how many of
     the 35 lie that deep. */
  .ruler {
    left: 26px;
    /* Under the view switch, not centred: centred it drifted into the legend
       below it on anything shorter than a desktop screen. */
    top: 84px;
    background: var(--panel);
    border: 1px solid var(--line);
    backdrop-filter: blur(6px);
    padding: 14px 16px;
    width: 244px;
  }

  .ruler h3 {
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* A whole sentence, so it drops the mono uppercase of the other captions. */
  .ruler .caption {
    margin: 7px 0 11px;
    font-size: 10.5px;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .ruler ul { list-style: none; display: grid; gap: 2px; }

  .ruler li {
    display: grid;
    grid-template-columns: 16px 1fr 48px;
    align-items: center;
    gap: 10px;
    padding: 6px;
    border: 1px solid transparent;
    color: var(--ink-dim);
    cursor: pointer;
  }

  .ruler li:hover, .ruler li.on { color: var(--ink); }
  .ruler li.on { border-color: var(--line); background: color-mix(in srgb, var(--ink) 5%, transparent); }

  .ruler .lvl {
    font-family: var(--mono);
    font-size: 16px;
    line-height: 1;
    color: inherit;
  }

  .ruler .tool {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ruler .yrs {
    display: block;
    font-size: 10px;
    font-style: normal;
    text-transform: none;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
    margin-top: 3px;
  }

  /* The tally: a bar scaled against the fullest depth, then the count. */
  .ruler .tally { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
  .ruler .tally i { height: 3px; width: calc(var(--w) * 26px); background: var(--ink-faint); }
  .ruler li:hover .tally i, .ruler li.on .tally i { background: var(--ink-dim); }

  .ruler .tally b {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    color: var(--ink-faint);
    min-width: 14px;
    text-align: right;
  }

  /* legend */
  .legend {
    left: 26px;
    bottom: 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    backdrop-filter: blur(6px);
    padding: 14px 16px;
    max-width: 280px;
  }

  .legend h3 {
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 9px;
  }

  .groupers + h3 { margin-top: 12px; }
  .groupers { display: flex; flex-wrap: wrap; gap: 4px; }

  .grp {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    padding: 5px 8px;
    cursor: pointer;
  }

  .grp:hover { color: var(--ink); border-color: var(--ink-dim); }
  .grp.on { color: var(--ink); background: color-mix(in srgb, var(--ink) 8%, transparent); border-color: var(--ink-dim); }

  .legend ul { list-style: none; display: grid; gap: 4px; }

  .legend li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    color: var(--ink-dim);
    cursor: pointer;
    padding: 3px 6px;
    border: 1px solid transparent;
  }

  .legend li:hover { color: var(--ink); }
  .legend li.on { color: var(--ink); border-color: var(--line); background: color-mix(in srgb, var(--ink) 5%, transparent); }
  .legend i { width: 10px; height: 10px; flex: 0 0 auto; }
  .legend em { font-style: normal; color: var(--ink-faint); font-family: var(--mono); font-size: 10px; margin-left: auto; }

  .legend .foot {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    line-height: 1.6;
  }

  /* ── the sheet modal ─────────────────────────────────── */
  /* Its body is lifted out of /moats/N/, so it arrives without the scope
     attribute Astro stamps on this page — every rule below has to be global. */
  .sheet-modal {
    width: min(720px, calc(100vw - 32px));
    max-height: min(84vh, 900px);
    margin: auto;
    padding: 32px 36px 28px;
    border: 1px solid var(--line);
    background: var(--panel-solid);
    color: var(--ink);
    overflow: auto;
    position: relative;
  }

  .sheet-modal::backdrop { background: rgba(10, 8, 5, 0.66); }

  .sheet-modal .close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-dim);
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
  }

  .sheet-modal .close:hover { color: var(--ink); border-color: var(--ink-dim); }

  .sheet-modal .modal-page {
    display: inline-block;
    margin-top: 26px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
  }

  .sheet-modal .modal-page:hover { color: var(--ink); }

  .sheet-modal :global(.eyebrow) {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 10px;
  }

  .sheet-modal :global(.rock-tag) { display: inline-flex; align-items: center; gap: 6px; }
  .sheet-modal :global(.rock-tag i) { width: 8px; height: 8px; }

  .sheet-modal :global(h1) {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }

  .sheet-modal :global(h2) {
    font-family: var(--display);
    font-weight: 400;
    font-size: 18px;
    letter-spacing: 0.03em;
    margin-bottom: 10px;
  }

  .sheet-modal :global(h3) {
    font-family: var(--body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .sheet-modal :global(p) { font-size: 14px; line-height: 1.7; color: var(--ink-dim); }
  .sheet-modal :global(section) { margin-bottom: 28px; }
  .sheet-modal :global(section:last-of-type) { margin-bottom: 0; }

  .sheet-modal :global(.example) { margin-bottom: 18px; }
  .sheet-modal :global(.example:last-child) { margin-bottom: 0; }

  .sheet-modal :global(.verdict) { border-left: 2px solid var(--ink-faint); padding-left: 16px; }

  .sheet-modal :global(.sample .note) {
    margin-top: 10px;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .sheet-modal :global(.draft) {
    border: 1px solid var(--line);
    border-left: 2px solid var(--ink-dim);
    padding: 12px 14px;
    font-size: 13px;
    margin: 18px 0 30px;
  }

  /* Both the passport and the sample block are the same two-column list. */
  .sheet-modal :global(dl) { border-top: 1px solid var(--line); }

  .sheet-modal :global(.row) {
    display: flex;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }

  .sheet-modal :global(dt) {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    min-width: 140px;
  }

  .sheet-modal :global(dd) { color: var(--ink); margin-left: auto; text-align: right; }
  .sheet-modal :global(.placeholder) { color: var(--ink-faint); font-family: var(--mono); }

  /* Sheet III's back-links, cloned in with the rest of the article. */
  .sheet-modal :global(.backlinks ul) { list-style: none; display: grid; gap: 1px; border-top: 1px solid var(--line); }
  .sheet-modal :global(.backlinks li) { padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 13px; line-height: 1.55; }
  .sheet-modal :global(.backlinks .kind) { margin-top: 16px; }
  .sheet-modal :global(.backlinks h3) {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 6px;
  }
  .sheet-modal :global(.backlinks .note), .sheet-modal :global(.backlinks .none) { color: var(--ink-dim); }
  .sheet-modal :global(.backlinks .map) {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  @media (max-width: 640px) {
    .sheet-modal { padding: 26px 18px 22px; }
    .sheet-modal :global(.row) { flex-direction: column; gap: 4px; }
    .sheet-modal :global(dd) { margin-left: 0; text-align: left; }
  }

  /* specimen card */
  .specimen {
    right: 26px;
    top: 50%;
    transform: translateY(-46%);
    width: 296px;
    background: var(--panel);
    border: 1px solid var(--line);
    backdrop-filter: blur(6px);
    padding: 18px;
  }

  .specimen .close {
    position: absolute;
    top: 10px;
    right: 10px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-dim);
    width: 24px;
    height: 24px;
    cursor: pointer;
    font-size: 11px;
    line-height: 1;
  }

  .specimen .close:hover { color: var(--ink); border-color: var(--ink-dim); }
  .specimen .close[hidden] { display: none; }

  .specimen .eyebrow {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .specimen h3 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 22px;
    letter-spacing: 0.03em;
    margin: 8px 0 12px;
  }

  .specimen .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 14px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 10px 0;
    margin-bottom: 12px;
  }

  .specimen .stats[hidden] { display: none; }
  .specimen .stats b { color: var(--ink); font-weight: 500; }
  .specimen p { font-size: 12px; line-height: 1.55; color: var(--ink-dim); }

  .specimen a {
    display: inline-block;
    margin-top: 14px;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--ink-dim);
    padding-bottom: 2px;
  }

  .specimen a:hover { border-color: var(--ink); }
  .specimen a[hidden] { display: none; }

  /* status line + hint */
  /* Centred by a full-width strip, not by `left: 50%` — that one gave the pill
     only half the stage to lay its line out in, and it wrapped early. */
  .status { left: 0; right: 0; bottom: 24px; text-align: center; }

  .status span {
    display: inline-block;
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 8px 16px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
    max-width: calc(100% - 40px);
  }

  /* The first-contact hint is the one line the section says first. */
  .status[data-first-contact] span { color: var(--ink); border-color: var(--ink-dim); }

  /* The right corner stacks upwards: the status pill owns the bottom line and
     the scene's hint sits above it. Their widths are copy-driven, so sharing
     a band would put them on top of each other. */
  .hint { right: 26px; bottom: 76px; }

  .hint span {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* The left column holds the view switch, the ruler and the legend. On a
     short screen the ruler folds: the caption goes (the guide says the same
     at length) and the years move onto the tool's line. Shorter still and it
     stands down altogether. */
  @media (max-height: 880px) {
    .ruler .caption { display: none; }
    .ruler .yrs { display: inline; margin-left: 8px; }
    .ruler .tool { white-space: nowrap; }
    .ruler { width: 268px; }
    .ruler li { padding: 4px 6px; }
  }

  @media (max-height: 730px) {
    .ruler { display: none; }
  }

  /* Narrow desktops cannot hold the hint beside the card — and the guide
     spells the controls out anyway. The status pill centres in what is left
     beside the legend rather than in the stage, or it runs under it. */
  @media (max-width: 1100px) {
    .hint { display: none; }
    .status { left: 320px; right: 26px; }
  }

  /* Below the tablet breakpoint the stage cannot hold its corners — but the
     breakpoint is the pointer, not the width. A phone asked for the desktop
     site reports 980px and used to get the overlay HUD folded onto itself and
     a 980×2120 drawing buffer on a phone GPU. Coarse pointer catches that
     case; the width keeps small windows honest. */
  @media (max-width: 900px), (pointer: coarse) {
    /* Nothing is pinned any more: the stage is a column and the panels sit
       under the section instead of on top of it. Order lives here rather than
       in the markup so the desktop overlay keeps the source order it needs. */
    .stage {
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow: visible;
    }

    .hud { position: relative; inset: auto; }

    /* The hint describes a mouse, and the status line duplicates the specimen
       card, which is now in the column right under the drawing. */
    .hint, .status { display: none; }

    /* The section stops being a backdrop and becomes a band of its own. That
       band is a third of the pixels the full screen was, and the frame time
       here tracks the pixel count almost exactly. */
    #scene {
      position: relative;
      inset: auto;
      order: 2;
      width: 100%;
      /* Shaped, not just sized: the section is wider than it is deep, so a
         band of roughly its own proportions is what puts the camera closest
         to it. The cap keeps the drawing from pushing the panels off a short
         screen in landscape. */
      aspect-ratio: 4 / 3;
      height: auto;
      max-height: 56svh;
      border-bottom: 1px solid var(--line);
      /* A thumb dragging up and down is scrolling the page, which has a hero
         above this band to return to; sideways turns the section, and two
         fingers still zoom it. */
      touch-action: pan-y;
    }

    /* The top strip becomes the top of the band, its controls a wrapping row.
       It is also on a budget: whatever it spends is height the drawing does
       not get, so the tabs drop their second line. */
    .top { order: 1; flex-wrap: wrap; padding: 14px 16px 12px; gap: 8px; }
    .top-right { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px; }
    .tab { padding: 8px 14px; }
    .tab strong { font-size: 13px; }
    /* "Sheet I · cross-section" is a caption for a tab that already says it. */
    .tab span { display: none; }

    /* Under the drawing, in the order the section is read: what you tapped,
       what to lay it out by, and what the depth axis means. The panels lose
       the blur — a live canvas under a backdrop filter is re-blurred every
       frame — and cap their line length for the 980px desktop-site case. */
    .specimen, .side {
      width: 100%;
      max-width: min(720px, calc(100% - 32px));
      margin: 16px auto 0;
      inset: auto;
      transform: none;
      backdrop-filter: none;
    }

    /* Inside the rail the two panels stack and fill it. */
    .side { display: grid; gap: 16px; }
    .side .legend, .side .ruler {
      position: static;
      width: 100%;
      max-width: none;
      margin: 0;
      backdrop-filter: none;
    }

    .specimen { order: 3; }
    .side { order: 4; margin-bottom: 16px; }
    .ruler { display: block; }
    .ruler .caption { display: block; }

    /* The list joins the column between the controls and the footer. */
    :global(html.view-list) .atlas-list {
      order: 5;
      width: 100%;
      max-width: min(720px, calc(100% - 32px));
      margin: 16px auto 0;
    }
  }

  /* ── the view switch ─────────────────────────────────── */
  .view-switch {
    display: flex;
    border: 1px solid var(--line);
    background: var(--panel);
    backdrop-filter: blur(6px);
  }

  .view-switch[hidden] { display: none; }

  .view-switch a {
    padding: 8px 14px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-dim);
    border-left: 1px solid var(--line);
  }

  .view-switch a:first-child { border-left: 0; }
  .view-switch a:hover { color: var(--ink); }

  .view-switch a[aria-current] {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  /* ── the list view ───────────────────────────────────── */
  /* Sheet I's text mode. `html.view-list` is set before first paint by the
     inline bootstrap; everything below keys off it, so the two views are one
     stage and one set of controls. */
  .atlas-list { display: none; }

  :global(html.view-list) .atlas-list { display: block; }

  /* The scene and its instruments stand down; the list carries the content. */
  :global(html.view-list) #scene,
  :global(html.view-list) .specimen,
  :global(html.view-list) .status,
  :global(html.view-list) .hint { display: none; }

  /* The stage stops being a screen and becomes a reading page: the controls
     in a rail, the 35 sheets in a column. */
  :global(html.view-list) .stage { height: auto; min-height: 0; overflow: visible; }
  :global(html.view-list) .hud { position: static; inset: auto; }
  :global(html.view-list) .legend { max-width: none; }
  /* The short-screen media rules fold the ruler for the overlay; as a column
     of text the page has room for all of it. */
  :global(html.view-list) .ruler { display: block; width: auto; }
  :global(html.view-list) .ruler .caption { display: block; }
  :global(html.view-list) .ruler .yrs { display: block; margin-left: 0; }

  /* Only for the fine pointer above the tablet break — the coarse branch above
     already lays the whole stage in one column. */
  @media (min-width: 901px) and (pointer: fine) {
    :global(html.view-list) .stage {
      display: grid;
      grid-template-columns: 288px minmax(0, 720px);
      grid-template-areas:
        "top top"
        "side list";
      grid-template-rows: auto 1fr;
      justify-content: center;
      align-items: start;
      column-gap: 48px;
      padding: 0 26px;
    }

    :global(html.view-list) .top { grid-area: top; padding: 22px 0 18px; }

    :global(html.view-list) .side {
      grid-area: side;
      position: sticky;
      top: 22px;
      display: grid;
      gap: 16px;
    }

    :global(html.view-list) .atlas-list { grid-area: list; padding-bottom: 48px; }
  }

  /* Group chrome is rebuilt by atlas-list.ts without Astro's scope attribute,
     so it is addressed through :global under the server-rendered ancestor —
     the calculator's rule. The entries themselves are server-rendered and
     only ever re-parented, so their selectors stay scoped. */
  .atlas-list :global(.list-group) { margin-bottom: 36px; }

  .atlas-list :global(.list-group > h3) {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line);
    padding-bottom: 9px;
  }

  .atlas-list :global(.list-group .dot) { width: 10px; height: 10px; flex: 0 0 auto; }

  .atlas-list :global(.list-group > h3 em) {
    margin-left: auto;
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .atlas-list :global(.list-group ol) { list-style: none; }

  .entry { padding: 18px 0; border-bottom: 1px solid var(--line); }

  .entry-head { display: flex; align-items: baseline; gap: 12px; }

  .entry-head .n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-faint);
    min-width: 22px;
    text-align: right;
  }

  .entry-head h4 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 19px;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .entry-head a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    margin: 9px 0 0 34px;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    color: var(--ink-dim);
    border: 1px solid var(--line);
    padding: 3px 8px;
  }

